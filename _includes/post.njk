---
layout: base.njk
---
<article>
  <header>
    <h1>{{ title }}</h1>
    <p class="meta">
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      {%- if tags %}
      · {{ tags | join(", ") }}
      {%- endif %}
    </p>
  </header>

  {{ content | safe }}
</article>

<p class="back"><a href="/posts/">← All writing</a></p>
